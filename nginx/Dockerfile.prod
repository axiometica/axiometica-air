# ─────────────────────────────────────────────────────────────────────────────
# Production nginx image — TLS termination + reverse proxy
#
# All static content is served by the agentic_os_frontend container.
# This image handles TLS, security headers, and proxies:
#   /api, /ws  → backend:8000 (direct)
#   /*         → frontend:3000
#
# The demo overlay can inject additional location blocks by mounting
# files into /etc/nginx/locations.d/ (included inside the server block).
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:alpine

RUN apk add --no-cache openssl

# Production nginx config (TLS + proxy, no static files)
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Empty directory for optional location overrides (demo overlay mounts here)
RUN mkdir -p /etc/nginx/locations.d

# Entrypoint generates a self-signed cert on first boot if none exists
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Lock down file ownership so nginx workers can read config
RUN chown -R nginx:nginx /etc/nginx/conf.d /etc/nginx/locations.d

EXPOSE 80 443

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
